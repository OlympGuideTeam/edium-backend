api.edium.online {
	# Doorman — аутентификация
	handle /api/v1/otp/* {
		reverse_proxy doorman:80
	}
	handle /api/v1/auth/* {
		reverse_proxy doorman:80
	}
	handle /.well-known/* {
		reverse_proxy doorman:80
	}

	# Будущие сервисы:
	# handle /api/v1/users/* {
	# 	reverse_proxy caesar:80
	# }
	# handle /api/v1/classes/* {
	# 	reverse_proxy caesar:80
	# }
	# handle /api/v1/quizzes/* {
	# 	reverse_proxy riddler:80
	# }

	handle {
		respond "Not Found" 404
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

grafana.edium.online {
	reverse_proxy grafana:3000
}
