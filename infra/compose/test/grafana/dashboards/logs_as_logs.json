{
    "title": "Логи сервисов как логи",
    "uid": "edium-logs",
    "version": 1,
    "schemaVersion": 39,
    "tags": ["edium", "logs"],
    "time": { "from": "now-1h", "to": "now" },
    "refresh": "30s",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "links": [],
    "annotations": { "list": [] },
    "fiscalYearStartMonth": 0,
    "liveNow": false,
    "weekStart": "",
    "templating": {
      "list": [
        {
          "current": { "selected": true, "text": "All", "value": "%" },
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
          "definition": "SELECT DISTINCT service FROM logs ORDER BY service",
          "hide": 0,
          "includeAll": true,
          "allValue": "%",
          "label": "Сервис",
          "multi": false,
          "name": "service",
          "options": [],
          "query": "SELECT DISTINCT service FROM logs ORDER BY service",
          "refresh": 2,
          "regex": "",
          "sort": 1,
          "type": "query"
        },
        {
          "current": { "selected": true, "text": "All", "value": "%" },
          "hide": 0,
          "includeAll": false,
          "label": "Уровень",
          "multi": false,
          "name": "level",
          "options": [
            { "selected": true, "text": "All", "value": "%" },
            { "selected": false, "text": "debug", "value": "debug" },
            { "selected": false, "text": "info", "value": "info" },
            { "selected": false, "text": "warn", "value": "warn" },
            { "selected": false, "text": "error", "value": "error" }
          ],
          "query": "All : %, debug : debug, info : info, warn : warn, error : error",
          "type": "custom"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Всего логов",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
          "overrides": []
        },
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
            "format": 0,
            "rawSql": "SELECT count() AS count FROM logs WHERE $__timeFilter(timestamp) AND service LIKE '${service}' AND level LIKE '${level}'",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Ошибки",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
            "format": 0,
            "rawSql": "SELECT count() AS count FROM logs WHERE $__timeFilter(timestamp) AND service LIKE '${service}' AND level = 'error'",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Предупреждения",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
            "format": 0,
            "rawSql": "SELECT count() AS count FROM logs WHERE $__timeFilter(timestamp) AND service LIKE '${service}' AND level = 'warn'",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "type": "timeseries",
        "title": "Объём логов по сервисам",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
        },
        "fieldConfig": {
          "defaults": { "custom": { "lineWidth": 1, "fillOpacity": 10 } },
          "overrides": []
        },
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
            "format": 1,
            "rawSql": "SELECT toStartOfMinute(timestamp) AS time, count() AS logs, service FROM logs WHERE $__timeFilter(timestamp) AND service LIKE '${service}' AND level LIKE '${level}' GROUP BY time, service ORDER BY time ASC",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "type": "table",
        "title": "Логи",
        "gridPos": { "h": 16, "w": 24, "x": 0, "y": 12 },
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
        "options": {
          "sortBy": [],
          "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" },
          "showHeader": true,
          "frameIndex": 0,
          "cellHeight": "sm"
        },
        "fieldConfig": {
          "defaults": { "custom": { "align": "left", "displayMode": "auto", "filterable": true } },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "timestamp" },
              "properties": [
                { "id": "custom.width", "value": 190 },
                { "id": "displayName", "value": "Время" }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "service" },
              "properties": [
                { "id": "custom.width", "value": 120 },
                { "id": "displayName", "value": "Сервис" }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "level" },
              "properties": [
                { "id": "custom.width", "value": 80 },
                { "id": "displayName", "value": "Уровень" },
                {
                  "id": "custom.displayMode",
                  "value": "color-background"
                },
                {
                  "id": "mappings",
                  "value": [
                    { "type": "value", "options": { "error": { "color": "red", "index": 0 } } },
                    { "type": "value", "options": { "warn": { "color": "orange", "index": 1 } } },
                    { "type": "value", "options": { "info": { "color": "blue", "index": 2 } } },
                    { "type": "value", "options": { "debug": { "color": "gray", "index": 3 } } }
                  ]
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "message" },
              "properties": [
                { "id": "displayName", "value": "Сообщение" },
                { "id": "custom.wrap", "value": true }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "trace_id" },
              "properties": [
                { "id": "custom.width", "value": 220 },
                { "id": "displayName", "value": "Trace ID" },
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "Открыть трейс в Jaeger",
                      "url": "",
                      "internal": {
                        "datasourceUid": "edium-jaeger",
                        "datasourceName": "Jaeger",
                        "query": {
                          "queryType": "byid",
                          "query": "${__value.raw}"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "edium-clickhouse" },
            "format": 0,
            "rawSql": "SELECT timestamp, service, level, message, trace_id FROM logs WHERE $__timeFilter(timestamp) AND service LIKE '${service}' AND level LIKE '${level}' ORDER BY timestamp DESC LIMIT 500",
            "refId": "A"
          }
        ]
      }
    ]
  }
