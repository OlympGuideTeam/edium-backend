# Yandex Cloud — ML-аккаунт (отдельный от основного)
ML_REGISTRY_ID=CHANGE_ME
IMAGE_TAG=latest

# Домен для TLS (Caddy автоматически получит сертификат Let's Encrypt)
SPHINX_DOMAIN=sphinx.ml.edium.online

# Авторизация — общий секрет между Sphinx и Riddler/Yoda
SPHINX_API_KEY=CHANGE_ME

# HuggingFace — приватный репо с адаптерами
HF_TOKEN=hf_CHANGE_ME

# Model (дефолты в docker-compose.yml, менять не обязательно)
# MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
# EXTRACTION_ADAPTER=edium/sphinx-extraction-lora
# GENERATION_ADAPTER=edium/sphinx-generation-lora
# MAX_NEW_TOKENS=2048
# TEMPERATURE=0.3
