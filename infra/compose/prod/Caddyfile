edium.online, www.edium.online {
	root * /srv/landing
	file_server
	encode gzip
}

api.edium.online {
    handle /doorman/v1/* {
        reverse_proxy doorman:80
    }
    handle /caesar/v1/* {
        reverse_proxy caesar:80
    }
    handle /herald/v1/* {
        reverse_proxy herald:80
    }
    handle {
        respond "Not Found" 404
    }
}

grafana.edium.online {
    reverse_proxy grafana:3000
}

jaeger.edium.online {
    basicauth {
        admin ${JAEGER_BASIC_AUTH_HASH}
    }
    reverse_proxy jaeger:16686
}

links.edium.online {
    handle /.well-known/apple-app-site-association {
        header Content-Type application/json
        respond `{"applinks":{"details":[{"appIDs":["FV7B395QF2.online.edium.app"],"components":[{"/":"/invite/*"}]}]}}`
    }
    handle {
        respond "Not Found" 404
    }
}
