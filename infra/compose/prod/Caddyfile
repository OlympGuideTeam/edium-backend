edium.online, www.edium.online {
    handle /.well-known/apple-app-site-association {
        header Content-Type application/json
        respond `{"webcredentials":{"apps":["FV7B395QF2.online.edium.app"]}}`
    }
    # Статические юридические страницы (сборка landing: public/terms, public/privacy)
    redir /terms /terms/ 308
    redir /privacy /privacy/ 308
    handle {
        root * /srv/landing
        file_server
        encode gzip
    }
}

api.edium.online {
    handle /doorman/v1/* {
        reverse_proxy doorman:80
    }
    handle /caesar/v1/* {
        reverse_proxy caesar:80
    }
    handle /herald/v1/* {
        reverse_proxy herald:80
    }
    handle /riddler/v1/* {
        reverse_proxy riddler:80
    }
    handle /louvre/v1/* {
        reverse_proxy louvre:80
    }
    handle {
        respond "Not Found" 404
    }
}

grafana.edium.online {
    reverse_proxy grafana:3000
}

jaeger.edium.online {
    basicauth {
        admin ${JAEGER_BASIC_AUTH_HASH}
    }
    reverse_proxy jaeger:16686
}

links.edium.online {
    handle /.well-known/apple-app-site-association {
        header Content-Type application/json
        respond `{"applinks":{"details":[{"appIDs":["FV7B395QF2.online.edium.app"],"components":[{"/":"/invite/*"}]}]}}`
    }
    handle /.well-known/assetlinks.json {
        header Content-Type application/json
        respond `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"online.edium.app","sha256_cert_fingerprints":["22:73:2D:8A:A4:34:4D:10:89:AD:A0:3D:FB:E9:4A:8F:A8:BF:3F:DD:E8:31:99:70:20:A1:44:8E:D1:9F:BB:8B","54:B4:C0:F2:7B:66:05:A1:87:D1:E8:65:30:7D:93:36:8C:BB:D8:02:B3:7A:75:D1:D2:DA:F2:3F:77:A3:EA:DC"]}}]`
    }
    handle {
        respond "Not Found" 404
    }
}
