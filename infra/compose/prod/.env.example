# Yandex Container Registry
YC_REGISTRY_ID=crpXXXXXXXXXXXXXX

# Image tag (задаётся при деплое)
IMAGE_TAG=latest

# Doorman — PostgreSQL (Managed)
DOORMAN_PG_USER=doorman_prod
DOORMAN_PG_PWD=CHANGE_ME
DOORMAN_PG_DB=doorman_prod
PG_HOST=rc1a-XXXXXXXXX.mdb.yandexcloud.net

# Doorman — Redis (Managed)
DOORMAN_REDIS_PWD=CHANGE_ME
REDIS_HOST=rc1a-XXXXXXXXX.rdb.yandexcloud.net

# JWT
JWT_RSA_PRIVATE_KEY=CHANGE_ME
JWT_ACTIVE_KID=key-1

# Herald — PostgreSQL (Managed)
HERALD_PG_USER=herald_prod
HERALD_PG_PWD=CHANGE_ME
HERALD_PG_DB=herald_prod

# Herald — Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME

# Charon — PostgreSQL (Managed)
CHARON_PG_USER=charon_prod
CHARON_PG_PWD=CHANGE_ME
CHARON_PG_DB=charon_prod

# Charon — Redis (Managed, DB 1)
CHARON_REDIS_PWD=CHANGE_ME

# Charon — DeepSeek
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Sphinx — gRPC (ML-аккаунт, отдельная VM)
SPHINX_GRPC_ADDR=sphinx.ml.edium.online:443
SPHINX_API_KEY=CHANGE_ME
