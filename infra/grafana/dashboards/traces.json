{
  "title": "Трейсы сервисов",
  "uid": "edium-traces",
  "version": 2,
  "schemaVersion": 39,
  "tags": ["edium", "traces"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "annotations": { "list": [] },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Сервис",
        "datasource": { "type": "jaeger", "uid": "edium-jaeger" },
        "query": "services",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "options": [],
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "Список трейсов",
      "description": "Выберите операцию в настройках запроса. Нажмите на трейс для просмотра waterfall.",
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "jaeger", "uid": "edium-jaeger" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "jaeger", "uid": "edium-jaeger" },
          "queryType": "search",
          "service": "${service}",
          "refId": "A",
          "limit": 20
        }
      ]
    }
  ]
}
