meta {
  name: Create Quiz
  type: http
  seq: 4
}

post {
  url: {{riddlerUrl}}/riddler/v1/quizzes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Квиз по биологии",
    "description": "Проверочная работа за 3-ю четверть",
    "default_settings": {
      "total_time_limit_sec": 600,
      "shuffle_questions": true
    },
    "attach_to_module": {
      "module_id": "{{moduleId}}"
    }
  }
}

tests {
  const body = res.getBody();
  if (body.id) {
    bru.setEnvVar("quizId", body.id);
  }
}
