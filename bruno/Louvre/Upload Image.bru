meta {
  name: Upload Image
  type: http
  seq: 1
}

post {
  url: http://localhost:8086/louvre/v1/images/upload
  body: multipart
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:multipart {
  image: {
    file: @/path/to/image.png
    file_name: image.png
    mime_type: image/png
  }
}

tests {
  const body = res.getBody();
  if (body.id) {
    bru.setEnvVar("imageId", body.id);
  }
}
