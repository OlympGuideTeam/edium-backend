meta {
  name: Create Course Item
  type: http
  seq: 1
}

post {
  url: {{caesarUrl}}/caesar/v1/modules/{{moduleId}}/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "ref_id": "{{quizId}}",
    "type": "quiz",
    "order_index": 0
  }
}

tests {
  const body = res.getBody();
  if (body.id) {
    bru.setEnvVar("itemId", body.id);
  }
}
